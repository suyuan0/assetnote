# Local-only example values. Do not reuse these credentials in shared or production environments.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

POSTGRES_PORT=5432
POSTGRES_DB=assetnote
POSTGRES_USER=assetnote
POSTGRES_PASSWORD=assetnote_local

DATABASE_URL="postgresql://assetnote:assetnote_local@127.0.0.1:5432/assetnote?schema=public"
# Required by repository e2e tests; provision this separate database first.
TEST_DATABASE_URL="postgresql://assetnote:assetnote_local@127.0.0.1:5432/assetnote_test?schema=public"
